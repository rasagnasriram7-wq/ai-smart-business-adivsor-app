# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# VITE_API_BASE_URL: Optional base URL for API requests (e.g., https://your-app.vercel.app).
# Leave empty to use relative URLs when frontend and backend are hosted on the same domain.
VITE_API_BASE_URL=

